[Unit]
Description=CPU Power Tuner: пресеты лимитов CPU для профилей power-profiles-daemon
# Без After=power-profiles-daemon.service: в ppd 0.30 он сам запускается после multi-user.target,
# и такая зависимость давала цикл — systemd выкидывал нашу службу при загрузке.
# Ждать ppd не нужно: служба читает его state.ini и перепроверяет EPP каждые 5 с.

[Service]
Type=simple
Environment=PYTHONPATH=/opt/cpu-power-tuner
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m cpt.daemon
RuntimeDirectory=cpu-power-tuner
RuntimeDirectoryMode=0755
StateDirectory=cpu-power-tuner
ConfigurationDirectory=cpu-power-tuner
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
